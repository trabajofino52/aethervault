# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port for Express + Vite server (must be 3000 in AI Studio preview)
PORT=3000

# ==============================================================================
# SEGURIDAD DE APLICACIÓN Y BASE DE DATOS
# Nota: En entorno VM/local todas las llaves usan temporalmente tu clave larga
#       unificada. Al pasar a un VPS público, rótalas por claves únicas de 64 hex.
# ==============================================================================
# Clave de cifrado AES-256-GCM en reposo (derivada con SHA-256)
DB_ENCRYPTION_KEY="Tripitaka@8069@9982@Profesor"

# Clave de firma HMAC-SHA256 para tokens de sesión
SESSION_SECRET="Tripitaka@8069@9982@Profesor"

# Clave maestra del Propietario (trabajofino52@gmail.com)
OWNER_MASTER_KEY="Tripitaka@8069@9982@Profesor"

# Secreto HMAC-SHA256 para validar webhooks de BTCPay Server (BTCPay-Sig)
BTCPAY_WEBHOOK_SECRET="Tripitaka@8069@9982@Profesor"

# Secreto IPN HMAC-SHA512 para NOWPayments
NOWPAYMENTS_IPN_SECRET="Tripitaka@8069@9982@Profesor"

# Pasarela Oficial PayPal REST API (Checkout Orders v2 + Payouts v1 + Webhooks)
# Obtén Client ID y Client Secret en https://developer.paypal.com/dashboard/applications
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

