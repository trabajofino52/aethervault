# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port for Express + Vite server (must be 3000 in AI Studio preview)
PORT=3000

# ==============================================================================
# SEGURIDAD DE APLICACIÓN Y BASE DE DATOS (Generar claves aleatorias en Debian 13)
# ==============================================================================
# Clave de cifrado AES-256-GCM en reposo (mínimo 32 caracteres aleatorios hex/base64)
DB_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_RANDOM_CHARS_IN_PRODUCTION"

# Clave de firma HMAC-SHA256 para tokens de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET="REPLACE_WITH_64_HEX_RANDOM_CHARS_IN_PRODUCTION"

# Clave maestra inicial del Propietario (trabajofino52@gmail.com)
OWNER_MASTER_KEY="GokuCheckersMasterKey2024Secure"

# PostgreSQL 17 TLS Connection (opcional para modo PostgreSQL en Debian 13)
# DATABASE_URL="postgresql://aethervault_app:STRONG_PASSWORD@127.0.0.1:5432/aethervault_db?sslmode=require"
